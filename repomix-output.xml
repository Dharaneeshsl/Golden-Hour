              {busy ? "Submitting Registration…" : "Submit Provider Registration for Approval"}
            </button>
          </form>
        )}

        {error && <p className="error" style={{ color: "#ef4444", marginTop: "1rem" }}>{error}</p>}
      </div>
    </section>
  );
}
