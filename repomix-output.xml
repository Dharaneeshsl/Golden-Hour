  const [detail, setDetail] = useState(null);
  const [error, setError] = useState("");
  const [editing, setEditing] = useState(false);
  const [editForm, setEditForm] = useState({
    bloodGroup: "",
    allergies: "",
    conditions: "",
    medications: "",
