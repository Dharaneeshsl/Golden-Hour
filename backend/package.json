{
  "name": "golden-hour-backend",
  "version": "2.2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/app.js",
    "start": "node src/app.js",
    "check": "node check.js",
    "test": "node --test test/services.test.js test/serverless.test.js test/vaultKeys.test.js test/postgres-migration.test.js test/auditExport.test.js test/awsKms.test.js",
    "db:migrate": "node src/config/migrate.js",
    "test:postgres": "node --test --test-concurrency=1 integration/postgres-login.js integration/reliability.test.js integration/key-rotation.test.js",
    "build": "node build.js"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1162.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "otpauth": "^9.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "supertest": "^7.2.2"
  }
}
