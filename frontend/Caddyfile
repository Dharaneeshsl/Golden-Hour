{
    servers {
        trusted_proxies static {$TRUSTED_PROXY_CIDRS:127.0.0.1/32}
    }
}
:3000 {
    root * /srv
    header {
        >Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; worker-src 'self'; manifest-src 'self'"
        >Strict-Transport-Security "max-age=31536000"
        >X-Frame-Options DENY
        >X-Content-Type-Options nosniff
        >Referrer-Policy no-referrer
        >Permissions-Policy "camera=(self), microphone=(), geolocation=()"
        >Cache-Control no-store
        -Server
    }
    handle /api/* {
        reverse_proxy {$API_UPSTREAM:backend:4000}
    }
    @assets path /assets/*
    handle @assets {
        file_server
    }
    handle {
        try_files {path} /index.html
        file_server
    }
}
